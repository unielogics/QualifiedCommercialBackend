# Database
DATABASE_URL=postgresql+asyncpg://qc:qc@localhost:5432/qc
DATABASE_URL_SYNC=postgresql+psycopg://qc:qc@localhost:5432/qc

# CORS — local dev. In prod, set to: https://app.qualifiedcommercial.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
PRIMARY_SUPER_ADMIN_EMAIL=franco@qualifiedcommercial.com

# AWS Bedrock (AI)
# Production uses BEDROCK_ENABLED=true with the EC2/IAM role. The bearer token
# is optional for environments that use Bedrock API-key auth.
BEDROCK_ENABLED=false
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_HEAVY=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_LIGHT=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Estimated Bedrock Claude prices per 1M tokens, used for local cost attribution.
# Daily alert thresholds are managed by super-admins in the dashboard.
AI_PRICING_LIGHT_INPUT_PER_MTOK=0.80
AI_PRICING_LIGHT_OUTPUT_PER_MTOK=4.00
AI_PRICING_HEAVY_INPUT_PER_MTOK=3.00
AI_PRICING_HEAVY_OUTPUT_PER_MTOK=15.00

# AWS S3 (documents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=qc-documents-dev

# Stripe billing / payment pre-authorization. Card collection happens through
# Stripe Elements / native Stripe SDKs; Qualified Commercial stores only
# Stripe IDs and non-sensitive card metadata.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# iSoftpull (credit) — public + private key pair from the iSoftPull dashboard.
# When unset, POST /credit/pull returns 503 (no synthetic fallback — we
# don't want a fake FICO unlocking simulator rates).
# ISOFTPULL_API_KEY is the legacy single-key alias; if set, treated as private_key.
ISOFTPULL_PUBLIC_KEY=
ISOFTPULL_PRIVATE_KEY=
ISOFTPULL_API_KEY=
ISOFTPULL_API_URL=https://app.isoftpull.com/api/v2
ISOFTPULL_TIMEOUT_SECONDS=15.0
ISOFTPULL_MAX_RETRIES=2
# Server-side login to iSoftPull's dashboard. Used to scrape the report HTML
# for the parsed FICO until the API token has Full Feed enabled.
ISOFTPULL_LOGIN_EMAIL=
ISOFTPULL_LOGIN_PASSWORD=
ISOFTPULL_DASHBOARD_URL=https://app.isoftpull.com

# Plaid business-bank connections. Production must use production credentials;
# the client rejects unknown environment values instead of falling back to sandbox.
# Confirm Statements access and register both OAuth redirects before switching.
DEALER_OS_PLAID_CLIENT_ID=
DEALER_OS_PLAID_SECRET=
DEALER_OS_PLAID_ENV=sandbox
DEALER_OS_PLAID_PRODUCTS=statements,assets
DEALER_OS_PLAID_CLIENT_NAME=Qualified Commercial - Capital OS
DEALER_OS_PLAID_WEBHOOK_URL=https://api.qualifiedcommercial.com/api/v1/webhooks/plaid
DEALER_OS_PLAID_REDIRECT_URI=https://app.qualifiedcommercial.com/dealer-os/plaid/oauth
DEALER_OS_PLAID_ROOM_REDIRECT_URI=https://app.qualifiedcommercial.com/client-room/plaid/oauth
PROVIDER_SECRETS_ENCRYPTION_KEY=

# RentCast (property)
RENTCAST_API_KEY=

# Provider-secret encryption. RentCast/Google provider keys are normally
# managed from the super-admin UI and stored encrypted in Postgres. In
# production, prefer AWS KMS with the EC2 instance role.
PROVIDER_SECRETS_KMS_KEY_ID=
PROVIDER_SECRETS_ENCRYPTION_KEY=

# Gmail (deferred — fake inbox until production)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
USE_FAKE_INBOX=true

# AWS SES outbound email. Production sends through the EC2 IAM role; no AWS
# keys are needed here. Leave SES_FROM_ADDRESS blank to keep outbound email
# dormant. In production this sender must match the IAM condition.
SES_FROM_ADDRESS=
SES_REGION=us-east-1
SES_CONFIGURATION_SET=

# Transactional SMS provider switch. Keep both providers configured and set
# exactly one active provider. No automatic fallback occurs on send failure.
SMS_PROVIDER=aws
SMS_PRODUCTION=false

# Existing AWS End User Messaging configuration.
SMS_ORIGINATION_NUMBER=
SMS_WEBHOOK_TOKEN=

# Twilio configuration. Prefer a restricted Standard API Key for outbound API
# authentication; TWILIO_AUTH_TOKEN remains required for webhook signatures.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURES=true

# Firebase Cloud Messaging — path to the Admin SDK service-account
# JSON used by app/services/push.py to send FCM v1 messages to the
# ANDROID app. Leave blank to disable Android push (no-ops silently).
# Download from Firebase Console → Project settings → Service accounts.
FIREBASE_CREDENTIALS_PATH=

# Apple Push Notification service (APNs) — iOS push for qcmobile-ios.
# Leave APNS_KEY_PATH blank to disable iOS push (no-ops silently).
# Create the key at Apple Developer → Certificates, IDs & Profiles →
# Keys → + (enable "Apple Push Notifications service"); download the
# .p8 ONCE. Use sandbox for dev-client builds, production (false)
# for TestFlight / App Store.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.qualifiedcommercial.mobile
APNS_USE_SANDBOX=true

# Misc
APP_ENV=development
LOG_LEVEL=INFO
