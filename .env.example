# Database
DATABASE_URL=postgresql+asyncpg://qc:qc@localhost:5432/qc
DATABASE_URL_SYNC=postgresql+psycopg://qc:qc@localhost:5432/qc

# CORS — local dev. In prod, set to: https://app.qualifiedcommercial.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Anthropic (AI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5

# AWS S3 (documents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=qc-documents-dev

# iSoftpull (credit)
ISOFTPULL_API_KEY=
ISOFTPULL_API_URL=https://api.isoftpull.com/v1

# RentCast (property)
RENTCAST_API_KEY=

# Gmail (deferred — fake inbox until production)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
USE_FAKE_INBOX=true

# Misc
APP_ENV=development
LOG_LEVEL=INFO
