# Secrets — NEVER commit
.env
.env.*
!.env.example
infra/terraform.tfvars
infra/*.auto.tfvars
*.pem
*.key
# Google service-account / OAuth credential JSONs
*service-account*.json
*-credentials.json
qualifiedcommercial-*.json
google-credentials.json
gcp-*.json

# Apple APNs auth key — never commit
*.p8
AuthKey_*.p8

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/tfplan
infra/*.backup
infra/crash.log
infra/bootstrap/.terraform/
infra/bootstrap/*.tfstate
infra/bootstrap/*.tfstate.*
infra/bootstrap/*.tfplan

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
